<Window x:Class="MacMirrorReceiver.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iMirror menu"
        AutomationProperties.Name="iMirror menu"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Assigned from TrayMenuPalette for the current Windows theme each time the menu opens. -->
        <SolidColorBrush x:Key="MenuForegroundBrush" Color="White" />
        <SolidColorBrush x:Key="MenuMutedBrush" Color="Gray" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="Transparent" />
        <SolidColorBrush x:Key="MenuPressedBrush" Color="Transparent" />
        <SolidColorBrush x:Key="MenuDividerBrush" Color="Gray" />
        <SolidColorBrush x:Key="MenuStatusBrush" Color="Gray" />

        <FontFamily x:Key="MenuIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="MenuItemButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Height="34"
                                Margin="4,1"
                                Padding="12,0"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MenuIconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="MenuDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="{DynamicResource MenuDividerBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="MenuRoot"
            MinWidth="232"
            Padding="0,4"
            CornerRadius="8"
            BorderThickness="0"
            Background="Transparent">
        <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle"
                    KeyboardNavigation.TabNavigation="Cycle">
            <!-- Header: what the receiver is doing right now. -->
            <Grid Margin="16,8,16,6" Focusable="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIconImage"
                       Width="24"
                       Height="24"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="iMirror"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MenuForegroundBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,1,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource MenuStatusBrush}" />
                        <TextBlock x:Name="StatusTextBlock"
                                   FontSize="12"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MenuMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource MenuDividerStyle}" />

            <Button x:Name="ShowButton"
                    Style="{StaticResource MenuItemButtonStyle}"
                    AutomationProperties.Name="Show iMirror"
                    Click="ShowButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE8A7;" />
                    <TextBlock Text="Show iMirror" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton"
                    Style="{StaticResource MenuItemButtonStyle}"
                    AutomationProperties.Name="Settings"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE713;" />
                    <TextBlock Text="Settings..." VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Style="{StaticResource MenuDividerStyle}" />

            <Button x:Name="ExitButton"
                    Style="{StaticResource MenuItemButtonStyle}"
                    AutomationProperties.Name="Exit iMirror"
                    Click="ExitButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE7E8;" />
                    <TextBlock Text="Exit" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
